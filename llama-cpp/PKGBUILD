# Maintainer: Amit Srivastava <xkimdr@gmail.com>
pkgname=llama-cpp
pkgver=b9842
pkgrel=1
pkgdesc="LLM inference in C/C++"
arch=('x86_64')
url="https://github.com/ggml-org/llama.cpp"
license=('MIT')
depends=('openblas' 'glibc' 'gcc-libs')
makedepends=('cmake')
optdepends=(
    'python-gguf: needed for convert_hf_to_gguf.py'
    'python-huggingface-hub: needed for convert_hf_to_gguf.py'
    'python-mistral-common: needed for convert_hf_to_gguf.py'
    'python-numpy: needed for convert_hf_to_gguf.py'
    'python-pytorch: needed for convert_hf_to_gguf.py'
    'python-safetensors: needed for convert_hf_to_gguf.py'
    'python-sentencepiece: needed for convert_hf_to_gguf.py'
    'python-transformers: needed for convert_hf_to_gguf.py'
)
provides=('llama.cpp' 'ggml' 'libggml')
conflicts=('llama.cpp' 'ggml' 'libggml')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('5fe27c1b2c147798ce08c883d027895c65a4ae4cfc6bd42c3088f890cac1576c')

_pkgname=llama.cpp

prepare() {
    cd "${_pkgname}-${pkgver}"
    mkdir -p build
}

build() {
    local _cmake_options=(
        -B build
        -S "${_pkgname}-${pkgver}"
        -DCMAKE_INSTALL_PREFIX='/usr'
        -DCMAKE_BUILD_TYPE=Release
        -DGGML_BLAS=ON
        -DGGML_BLAS_VENDOR=OpenBLAS
        -DGGML_NATIVE=ON
        -DGGML_LTO=ON
        -DLLAMA_BUILD_TESTS=OFF
        -DLLAMA_ALL_WARNINGS=OFF
        -Wno-dev
    )
    cmake "${_cmake_options[@]}"
    cmake --build build --config Release -j"$(nproc)"
}

package() {
    DESTDIR="${pkgdir}" cmake --install build

    cd "${_pkgname}-${pkgver}"
    install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" LICENSE
}
